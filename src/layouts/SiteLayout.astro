---
import "../styles/global.css";
import { sitePath } from "../sitePath";
import { handoffKey } from "../travelHandoff";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "星辰界 · 杨鑫成",
  description = "一片星海，几段日常。欢迎来到杨鑫成的个人小世界。",
} = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#050711" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={sitePath("site-icon.svg")} />
    <title>{title}</title>
    <script define:vars={{ handoffKey }}>
      try {
        const value = sessionStorage.getItem(handoffKey);
        sessionStorage.removeItem(handoffKey);
        if (value && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
          const { path, expires } = JSON.parse(value);
          if (path === location.pathname && Date.now() < expires) {
            document.documentElement.dataset.travelArrival = "";
            window.setTimeout(() => delete document.documentElement.dataset.travelArrival, 5000);
          }
        }
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <div class="travel-veil" aria-hidden="true"><span>正在载入星球影像</span></div>
  </body>
</html>
