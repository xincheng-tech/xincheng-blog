---
import SiteLayout from "../layouts/SiteLayout.astro";
import { sections } from "../data/sections";
import { UniverseExperience } from "../components/UniverseExperience";
---
<SiteLayout>
  <main class="home-shell">
    <div class="sky-wash" aria-hidden="true"></div>
    <UniverseExperience client:only="react" sections={sections} />

    <header class="site-header">
      <a class="wordmark" href="/" aria-label="星辰界首页">XINGCHEN <span>VERSE</span></a>
      <span class="header-note"><i></i> 一个人的小宇宙</span>
    </header>

    <section class="hero" aria-labelledby="site-title">
      <p class="eyebrow">GALAXY · 01</p>
      <h1 id="site-title">星辰界</h1>
      <p class="hero-copy">三颗行星，三段旅程。<br />选择一颗星，进入它的世界。</p>
    </section>

    <nav class="constellation" aria-label="栏目星辰">
      {sections.map((section) => (
        <a
          class:list={["constellation-link", "constellation-link--" + section.slug]}
          href={"/" + section.slug + "/"}
          data-slug={section.slug}
          style={"--accent:" + section.color}
          aria-label={"前往" + section.name + "星球：" + section.intro}
        >
          <span class="link-name">{section.name}</span>
          <span class="link-summary">{section.intro}</span>
        </a>
      ))}
    </nav>

    <footer class="site-footer">
      <span>杨鑫成 · PERSONAL UNIVERSE</span>
      <span>选择行星，开始星际漫游</span>
    </footer>
  </main>
</SiteLayout>
