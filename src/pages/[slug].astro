---
import SiteLayout from "../layouts/SiteLayout.astro";
import { sections } from "../data/sections";
import { planetSurfaces } from "../data/planetSurfaces";
import { SectionUniverseExperience } from "../components/SectionUniverseExperience";
import { sitePath } from "../sitePath";
import { sectionTextureFiles, solarTexturePath } from "../data/solarTextures";

export function getStaticPaths() {
  return sections.map((section) => ({
    params: { slug: section.slug },
    props: { section },
  }));
}

const { section } = Astro.props;
---
<SiteLayout title={section.name + " · 星辰界"} description={section.intro}>
  <Fragment slot="head">
    {sectionTextureFiles(section).map((file) => (
      <link rel="preload" as="image" type="image/webp" href={solarTexturePath(file)} crossorigin="anonymous" />
    ))}
  </Fragment>
  <main class="section-page section-galaxy" style={"--accent:" + section.color}>
    <div class="sky-wash" aria-hidden="true"></div>
    <SectionUniverseExperience client:only="react" section={section} />
    <header class="site-header">
      <a class="wordmark" href={sitePath()} aria-label="星辰界首页">XINGCHEN <span>VERSE</span></a>
      <span class="header-note"><i></i> 星际档案</span>
    </header>
    <a class="back-link" href={sitePath()} aria-label="返回星辰界首页">← 返回太阳系</a>
    <section class="section-hero" aria-labelledby="section-title">
      <p class="eyebrow">{planetSurfaces[section.surface].name}</p>
      <h1 id="section-title">{section.name}</h1>
      <p class="section-intro">{section.intro}</p>
    </section>
    <nav class="content-orbit-nav" aria-label={section.name + "内容星球"}>
      {section.items.map((item, index) => (
        <a
          id={"content-item-" + index}
          href={"#content-item-" + index}
          data-content-index={index}
          style={"--planet-accent:" + planetSurfaces[item.surface].color}
          aria-label={"聚焦内容星：" + item.title + "，" + item.meta}
        >
          <span class="content-orb-mark" aria-hidden="true"></span>
          <span class="content-orbit-copy">
            <strong>{item.title}</strong>
            <small>{planetSurfaces[item.surface].name} · {item.meta}</small>
          </span>
        </a>
      ))}
    </nav>
    <footer class="section-footer"><a class="art-credit-link" href={sitePath("credits/")}>影像来源</a></footer>
  </main>
</SiteLayout>
